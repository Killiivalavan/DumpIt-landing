# Local-only secrets. Copy this file to ".env" and fill in real values:
#   cp .env.example .env
# .env is gitignored and never committed. On Cloudflare Pages, set these
# same two names under Project → Settings → Environment variables instead.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=paste-the-anon-public-key-here
